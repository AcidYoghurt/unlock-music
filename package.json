    "build:all": "./scripts/build-and-package.sh --all",
    "test": "vitest run",
    "test:watch": "vitest",
    "pretty": "prettier --write \"src/**/*.{js,ts,vue,scss}\" \"*.{js,ts,json,md}\"",
    "pretty:check": "prettier --check \"src/**/*.{js,ts,vue,scss}\" \"*.{js,ts,json,md}\"",
    "make-extension": "node ./scripts/make-extension.js"
  },
  "dependencies": {
    "@element-plus/icons-vue": "2.3.2",
    "@xhacker/kgmwasm": "^1.0.0",
