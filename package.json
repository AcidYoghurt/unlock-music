  "license": "MIT",
  "description": "Unlock encrypted music file in browser.",
  "repository": {
    "type": "git",
    "url": "https://git.unlock-music.dev/um/web"
  },
  "engines": {
    "node": "24.20.0"
  },
  "private": true,
  "scripts": {
    "dev": "vite",
    "serve": "vite",
