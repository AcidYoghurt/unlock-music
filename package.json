    "@vitejs/plugin-vue": "6.0.8",
    "autoprefixer": "10.5.5",
    "postcss": "8.5.28",
    "prettier": "3.9.6",
    "sass": "1.104.0",
    "typescript": "6.0.3",
    "vite": "8.2.2",
    "vite-plugin-pwa": "1.3.0",
