    "browser-id3-writer": "^4.4.0",
    "buffer": "6.0.3",
    "crypto-js": "4.2.0",
    "element-plus": "2.14.5",
    "iconv-lite": "0.7.3",
    "jimp": "^0.16.1",
    "metaflac-js": "^1.0.5",
    "music-metadata": "^11.15.0",
    "vue": "3.5.42"
  },
